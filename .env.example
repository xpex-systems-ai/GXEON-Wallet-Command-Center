# ============================================================
# GXEON WALLET COMMAND CENTER - ENVIRONMENT CONFIGURATION
# ============================================================
# DO NOT COMMIT SENSITIVE VALUES OR PRIVATE KEYS TO THIS FILE.
# THIS FILE IS A TEMPLATE ONLY.

# Application Environment
VITE_APP_ENV=development
VITE_APP_NAME="GXEON Wallet Command Center"
VITE_APP_VERSION="1.0.0"

# Local Bridge Configuration (Bound to 127.0.0.1 on the operator's machine)
VITE_BRIDGE_URL=http://127.0.0.1:8790
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8790
BRIDGE_SECURITY_MODE=local_only

# Firebase Control Plane Configuration (Client-safe configuration keys)
# Note: Firebase API keys identify your project to Google servers; they do not grant admin access.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Supported Blockchain RPC Endpoints (Optional Custom RPCs - Read Only)
VITE_RPC_ETHEREUM_MAINNET=
VITE_RPC_BASE_MAINNET=
VITE_RPC_POLYGON_MAINNET=
VITE_RPC_ARBITRUM_MAINNET=
VITE_RPC_RUSTCHAIN_TESTNET=
# Taskmarket: public metadata only. Never add a wallet key or seed.
GXEON_TASKMARKET_WRITES_ENABLED=false
GXEON_TASKMARKET_WORKER_ADDRESS=

# Coinbase exchange account monitoring (server only; never VITE_*).
# Create an ES256 API key restricted to View and the intended portfolio.
COINBASE_READ_API_KEY_NAME=
COINBASE_READ_API_KEY_SECRET=
# Existing Firebase operator UID, verified out of band; never infer from email.
GXEON_OPERATOR_UID=
# Timestamp of a successful GXEON connector check; contains no account data.
GXEON_COINBASE_CONNECTOR_VERIFIED_AT=
