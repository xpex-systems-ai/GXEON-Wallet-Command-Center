{
  "openapi": "3.0.3",
  "info": {
    "title": "GXEON Autonomous Agent Capability Market & x402 Gateway API",
    "description": "Production GXEON Agent-to-Agent capability marketplace with Stripe LIVE hosted checkout for BRL services and canonical x402 V2 micro-USDC machine payments. Payment execution remains proof-gated and Money Truth compliant.",
    "version": "2.1.0"
  },
  "servers": [
    {
      "url": "https://gxeon-wallet-command-center.vercel.app",
      "description": "Production Server"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development"
    }
  ],
  "paths": {
    "/v1/services": {
      "get": {
        "summary": "List available capabilities and service catalog",
        "responses": {
          "200": {
            "description": "Array of available machine services",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "services": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Service"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "List active machine capabilities",
        "responses": {
          "200": {
            "description": "List of capability identifiers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing": {
      "get": {
        "summary": "Get atomic micro-USDC and credit pricing per capability",
        "responses": {
          "200": {
            "description": "Pricing catalog with billing rails",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/payment-methods": {
      "get": {
        "summary": "List supported payment rails",
        "responses": {
          "200": {
            "description": "Active payment rails",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentRails": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/checkout": {
      "post": {
        "summary": "Create a Stripe LIVE Checkout Session for GXEON Quick Fix",
        "description": "Creates an unpaid R$49.00 Checkout Session using server-authoritative pricing. Revenue remains zero until a verified LIVE Stripe webhook confirms payment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuickFixCheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout Session created; payment is still pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuickFixCheckoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "503": {
            "description": "Stripe or durable store not configured"
          }
        }
      }
    },
    "/v1/offers": {
      "post": {
        "summary": "Request an autonomous capability offer from GXEON Offer Agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Machine-consumable capability offer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilityOffer"
                }
              }
            }
          }
        }
      }
    },
    "/v1/negotiate": {
      "post": {
        "summary": "Negotiate volume pricing within operator guardrails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NegotiationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Negotiation decision (ACCEPT, COUNTER, or REJECT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NegotiationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/x402/json-validate": {
      "post": {
        "summary": "Validate and lint JSON payloads with x402 payment rail",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "description": "Base Mainnet USDC transaction hash or x402 payment proof",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rawJson": {
                    "type": "string"
                  },
                  "schema": {
                    "type": "object"
                  }
                },
                "required": [
                  "rawJson"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution successful with cryptographic receipt",
            "headers": {
              "PAYMENT-RESPONSE": {
                "schema": {
                  "type": "string"
                },
                "description": "Canonical x402 V2 receipt payload"
              },
              "X-402-Receipt": {
                "schema": {
                  "type": "string"
                },
                "description": "Receipt ID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402ExecutionSuccess"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required - challenge returned with Base USDC payment instructions",
            "headers": {
              "PAYMENT-REQUIRED": {
                "schema": {
                  "type": "string"
                },
                "description": "Canonical x402 V2 challenge requirements"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402Challenge"
                }
              }
            }
          },
          "409": {
            "description": "Replay Blocked - Transaction hash already consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Treasury not configured or autonomous selling suspended",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/x402/url-verify": {
      "post": {
        "summary": "Verify URL health, TLS certificate, and status code with x402 payment rail",
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "description": "Base Mainnet USDC transaction hash or x402 payment proof",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "urls": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "urls"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution successful with cryptographic receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402ExecutionSuccess"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required - challenge returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/X402Challenge"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/mcp": {
      "post": {
        "summary": "Model Context Protocol (MCP) JSON-RPC 2.0 endpoint",
        "description": "Exposes GXEON capabilities as MCP tools for Cursor, Claude, and autonomous agents.",
        "responses": {
          "200": {
            "description": "MCP JSON-RPC response"
          }
        }
      }
    },
    "/v1/billing/topup": {
      "get": {
        "operationId": "listAgentCreditPacks",
        "summary": "List prepaid GXEON agent request packs",
        "responses": {
          "200": {
            "description": "Available BRL prepaid credit packs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rail": {
                      "type": "string"
                    },
                    "currency": {
                      "type": "string"
                    },
                    "packs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "credits": {
                            "type": "integer"
                          },
                          "priceCents": {
                            "type": "integer"
                          },
                          "currency": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAgentCreditCheckout",
        "summary": "Create a Stripe Checkout for a prepaid GXEON agent pack",
        "description": "For a new agent, provide packId and name. The response can include a one-time GXEON API key that must be saved before payment. Checkout creation does not grant credits; credits are granted only after verified Stripe settlement.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "packId"
                ],
                "properties": {
                  "packId": {
                    "type": "string",
                    "enum": [
                      "pack_20",
                      "pack_50",
                      "pack_100",
                      "pack_250",
                      "pack_500",
                      "pack_2000"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "Required for first purchase when no Authorization header is supplied"
                  },
                  "accountId": {
                    "type": "string",
                    "description": "Only valid when bound to the authenticated account"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Unpaid Stripe Checkout created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "checkoutUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "sessionId": {
                      "type": "string"
                    },
                    "targetAccountId": {
                      "type": "string"
                    },
                    "apiKey": {
                      "type": "string",
                      "description": "Returned only on first account creation. Save securely before payment."
                    },
                    "pack": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid pack or input"
          },
          "401": {
            "description": "Invalid account authentication"
          },
          "503": {
            "description": "Payment rail unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QuickFixCheckoutRequest": {
        "type": "object",
        "required": [
          "customerEmail",
          "problemSummary"
        ],
        "properties": {
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string",
            "format": "email"
          },
          "problemSummary": {
            "type": "string"
          },
          "repoOrCodeUrl": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "opportunityId": {
            "type": "string"
          },
          "offerId": {
            "type": "string"
          }
        }
      },
      "QuickFixCheckoutResponse": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "checkoutUrl": {
            "type": "string",
            "format": "uri"
          },
          "sessionId": {
            "type": "string"
          }
        }
      },
      "Service": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "unitPriceCredits": {
            "type": "integer"
          },
          "unitPriceUsdc": {
            "type": "number"
          },
          "minimumChargeCredits": {
            "type": "integer"
          },
          "minimumChargeUsdc": {
            "type": "number"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PricingResponse": {
        "type": "object",
        "properties": {
          "pricing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            }
          },
          "billingRails": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OfferRequest": {
        "type": "object",
        "required": [
          "buyerAgentId",
          "requestedCapability",
          "quantity"
        ],
        "properties": {
          "buyerAgentId": {
            "type": "string"
          },
          "requestedCapability": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        }
      },
      "CapabilityOffer": {
        "type": "object",
        "properties": {
          "offerId": {
            "type": "string"
          },
          "seller": {
            "type": "string",
            "example": "GXEON"
          },
          "serviceId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "paymentMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ttlSeconds": {
            "type": "integer"
          }
        }
      },
      "NegotiationRequest": {
        "type": "object",
        "required": [
          "buyerAgentId",
          "requestedCapability",
          "requestedQuantity",
          "proposedUnitPriceCredits"
        ],
        "properties": {
          "buyerAgentId": {
            "type": "string"
          },
          "requestedCapability": {
            "type": "string"
          },
          "requestedQuantity": {
            "type": "integer"
          },
          "proposedUnitPriceCredits": {
            "type": "number"
          }
        }
      },
      "NegotiationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "COUNTER",
              "REJECTED"
            ]
          },
          "negotiationId": {
            "type": "string"
          },
          "acceptedPrice": {
            "type": "number"
          },
          "counterPrice": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "X402Challenge": {
        "type": "object",
        "properties": {
          "x402Version": {
            "type": "integer",
            "example": 2
          },
          "status": {
            "type": "integer",
            "example": 402
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "serviceId": {
            "type": "string"
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "example": "exact"
                },
                "network": {
                  "type": "string",
                  "example": "eip155:8453"
                },
                "asset": {
                  "type": "string",
                  "example": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
                },
                "amount": {
                  "type": "string",
                  "example": "10000"
                },
                "payTo": {
                  "type": "string"
                },
                "maxTimeoutSeconds": {
                  "type": "integer",
                  "example": 300
                }
              }
            }
          }
        }
      },
      "X402ExecutionSuccess": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "SUCCESS"
          },
          "serviceId": {
            "type": "string"
          },
          "result": {
            "type": "object"
          },
          "receipt": {
            "$ref": "#/components/schemas/X402Receipt"
          }
        }
      },
      "X402Receipt": {
        "type": "object",
        "properties": {
          "receiptId": {
            "type": "string",
            "example": "rcpt_1790631300_ab12"
          },
          "seller": {
            "type": "string",
            "example": "GXEON"
          },
          "buyer": {
            "type": "string"
          },
          "serviceId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "paymentRail": {
            "type": "string",
            "example": "x402"
          },
          "currency": {
            "type": "string",
            "example": "USDC"
          },
          "amountAtomic": {
            "type": "string",
            "example": "10000"
          },
          "amountUsdc": {
            "type": "string",
            "example": "0.010000"
          },
          "network": {
            "type": "string",
            "example": "eip155:8453"
          },
          "settlementId": {
            "type": "string"
          },
          "txHash": {
            "type": "string"
          },
          "blockNumber": {
            "type": "integer"
          },
          "jobId": {
            "type": "string"
          },
          "resultHash": {
            "type": "string"
          },
          "evidenceHash": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "x-gxeon-stripe-live": {
    "enabled": true,
    "serviceId": "gxeon_quick_fix_v1",
    "amountMinor": 4900,
    "currency": "brl",
    "checkoutEndpoint": "/v1/checkout",
    "publicPaymentLink": "https://buy.stripe.com/bJeeVd45Zgrp5EFdeV1B60b",
    "paymentLinkId": "plink_1UKpGBHDcsx7lyooXYeQg6Al"
  }
}
