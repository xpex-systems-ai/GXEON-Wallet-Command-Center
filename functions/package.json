{
  "name": "functions",
  "version": "1.0.0",
  "description": "GXEON Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  },
  "private": true
}
