{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/.well-known/$1"
    },
    {
      "source": "/openapi.json",
      "destination": "/openapi.json"
    },
    {
      "source": "/v1/jobs/:jobId/result",
      "destination": "/api/v1/result?jobId=:jobId"
    },
    {
      "source": "/v1/jobs/:jobId",
      "destination": "/api/v1/jobs?jobId=:jobId"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/v1/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|v1/|\\.well-known/|openapi\\.json).*)",
      "destination": "/index.html"
    }
  ]
}
